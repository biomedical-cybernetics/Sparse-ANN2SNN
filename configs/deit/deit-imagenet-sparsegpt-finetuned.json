{
  "id": "deit-imagenet-sparsegpt-finetuned",
  "engine": "deit",
  "stage": "train",
  "seeds": [
    0,
    1,
    2
  ],
  "paper": [
    "Table 2"
  ],
  "required_inputs": [
    "checkpoint",
    "mask"
  ],
  "depends_on": [
    "deit-imagenet-sparsegpt"
  ],
  "parameters": {
    "dataset": "ImageNet-1K",
    "model": "deit_base_patch16_224",
    "epochs": 21,
    "world_size": 8,
    "per_gpu_batch_size": 128,
    "global_batch_size": 1024,
    "base_learning_rate": 0.0005,
    "effective_learning_rate": 0.001,
    "optimizer": "AdamW",
    "optimizer_betas": [
      0.9,
      0.999
    ],
    "optimizer_epsilon": 1e-08,
    "weight_decay": 0.05,
    "minimum_learning_rate": 1e-05,
    "scheduler": "cosine",
    "warmup_learning_rate": 1e-06,
    "model_ema_decay": 0.99996,
    "checkpoint_selection": "earliest-strict-best-validation-accuracy",
    "validation_split": "test",
    "precision": "fp16_amp",
    "pretrained": false,
    "implementation": "finetune",
    "warmup_epochs": 5,
    "sparsity": 0.7,
    "tf32": false,
    "checkpoint_interval": 1,
    "fixed_topology": true,
    "arguments": []
  }
}
