{
  "id": "resnet18-cifar10-ours",
  "engine": "cnn",
  "stage": "train",
  "seeds": [
    15,
    16,
    17
  ],
  "world_size": 1,
  "paper": [
    "Table 1",
    "Figure 3",
    "Figure A1",
    "Table A1",
    "Table 6"
  ],
  "parameters": {
    "backend": "matched",
    "job": {
      "architecture": "ResNet-18",
      "dataset": "CIFAR10",
      "method": "ours",
      "dropout": null
    },
    "checkpoint_selection": {
      "metric": "accuracy",
      "tie": "earliest",
      "require_final_mask_budget": true
    },
    "training_configuration": {
      "epochs": 200,
      "batch": 128,
      "lr": 0.1,
      "optimizer": "SGD",
      "momentum": 0.9,
      "nesterov": true,
      "weight_decay": 0.0005,
      "warmup": 5,
      "start_factor": 0.1,
      "eta_min": 0.0,
      "precision": "bf16-forward-fp32-state-eval-topology",
      "tf32": false,
      "scaler": false,
      "conv_sparsity": 0.7,
      "density_window": 150,
      "conv_updates": 200,
      "rewire": 0.05,
      "delta": [
        0.25,
        0.75,
        0.01
      ],
      "linear_dense": true,
      "cpu_threads": 1,
      "workers": 0
    }
  },
  "required_inputs": [],
  "outputs": {
    "checkpoint": "artifacts/best_model.pth",
    "masks": "artifacts/best_masks.pth",
    "resume": "artifacts/checkpoints/last_checkpoint.pth"
  }
}
