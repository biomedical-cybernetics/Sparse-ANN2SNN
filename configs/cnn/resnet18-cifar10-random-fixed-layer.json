{
  "id": "resnet18-cifar10-random-fixed-layer",
  "engine": "cnn",
  "stage": "train",
  "seeds": [
    15,
    16,
    17
  ],
  "world_size": 1,
  "paper": [
    "Table 6"
  ],
  "parameters": {
    "backend": "controls",
    "job": {
      "architecture": "ResNet-18",
      "dataset": "CIFAR10",
      "method": "random-fixed-layer",
      "dropout": null
    },
    "checkpoint_selection": {
      "metric": "accuracy",
      "tie": "earliest",
      "require_final_mask_budget": true
    },
    "training_configuration": {
      "epochs": 200,
      "optimizer": "SGD",
      "lr": 0.1,
      "batch": 128,
      "momentum": 0.9,
      "nesterov": true,
      "weight_decay": 0.0005,
      "warmup": 5,
      "start_factor": 0.1,
      "eta_min": 0.0,
      "precision": "bf16-forward-fp32-state-eval-topology",
      "tf32": false,
      "scaler": false,
      "workers": 0,
      "cpu_threads": 1,
      "conv_sparsity": 0.7,
      "density_window": 150,
      "rewire": 0.05,
      "initialization": "original-same-seed-dense; isolated seed+100000 mask RNG",
      "degree_attempts_per_output": 200,
      "one_shot_no_finetune": false
    }
  },
  "required_inputs": [
    "ours_output"
  ],
  "outputs": {
    "checkpoint": "artifacts/best_model.pth",
    "masks": "artifacts/best_masks.pth",
    "resume": "artifacts/checkpoints/last_checkpoint.pth"
  }
}
