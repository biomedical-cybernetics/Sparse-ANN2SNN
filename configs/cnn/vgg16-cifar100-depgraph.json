{
  "id": "vgg16-cifar100-depgraph",
  "engine": "cnn",
  "stage": "train",
  "seeds": [
    15,
    16,
    17
  ],
  "world_size": 1,
  "paper": [
    "Table 1",
    "Figure 3",
    "Figure A2"
  ],
  "parameters": {
    "backend": "vgg",
    "job": {
      "variant": "linear99",
      "dataset": "CIFAR100",
      "method": "depgraph"
    },
    "checkpoint_selection": {
      "metric": "accuracy",
      "tie": "earliest",
      "require_final_mask_budget": true
    },
    "training_configuration": {
      "dropout": 0.5,
      "optimizer": "SGD",
      "lr": 0.1,
      "batch": 128,
      "momentum": 0.9,
      "nesterov": true,
      "weight_decay": 0.0005,
      "epochs": 300,
      "warmup": 5,
      "start_factor": 0.1,
      "eta_min": 0.0,
      "precision": "bf16-forward-fp32-state-eval-topology",
      "scaler": false,
      "tf32": false,
      "cpu_threads": 1,
      "workers": 0,
      "depgraph": {
        "epochs": [
          200,
          100
        ],
        "lr": [
          0.1,
          0.01
        ],
        "warmup": [
          5,
          5
        ],
        "cosine": [
          195,
          95
        ],
        "conv_ratio": 0.4522774424948339,
        "hidden_ratio": 0.9,
        "global": true,
        "one_shot": true,
        "pruner": "GroupNormPruner",
        "importance": "GroupMagnitudeImportance(p=2)",
        "selection": "fixed old layer-type ratio mapping; no count or accuracy search"
      },
      "selection": "full-test earliest maximum actual-budget-qualified",
      "order": "train-scheduler-evaluate-evolve-recovery"
    }
  },
  "required_inputs": [],
  "outputs": {
    "checkpoint": "artifacts/best_model.pth",
    "masks": "artifacts/best_masks.pth",
    "resume": "artifacts/checkpoints/last_checkpoint.pth"
  }
}
